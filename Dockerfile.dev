# URY Dashboard — Development Dockerfile
# Hot-reload capable development image
# Usage: docker compose -f docker-compose.dev.yml up

FROM node:22-alpine

WORKDIR /app

# Enable corepack for yarn
RUN corepack enable

# Install dependencies first (cached layer)
COPY package.json ./
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY pos/package.json ./pos/package.json

# Install all workspace dependencies
RUN yarn install --ignore-scripts || true

# Copy source code (mounted as volume in dev, but useful for build)
COPY . .

# Expose ports: 3000 (POS), 6006 (Storybook)
EXPOSE 3000 6006

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

# Start development server with hot-reload
CMD ["sh", "-c", "yarn install && yarn --cwd pos dev --host 0.0.0.0"]
