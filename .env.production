# ── URY Dashboard Production Configuration ───────────────
# Copy to .env and adjust for your deployment
# Generate secrets: openssl rand -base64 32

# ── Dashboard ───────────────────────────────────────────
DASHBOARD_PORT=3000

# ── NextAuth ───────────────────────────────────────────
# MUST change for production! Generate with: openssl rand -base64 32
NEXTAUTH_URL=https://dashboard.myrestaurant.com
NEXTAUTH_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-32

# ── Frappe Backend ─────────────────────────────────────
# URL of your Frappe/ERPNext server with URY module installed
FRAPPE_URL=https://erp.myrestaurant.com
FRAPPE_PORT=8000
FRAPPE_SOCKET_PORT=9000
FRAPPE_SITE_NAME=ury

# ── Dashboard Settings ─────────────────────────────────
REFRESH_INTERVAL=30000
RESTAURANT_NAME=URY Restaurant
CURRENCY=€

# ── Caddy (reverse proxy) ──────────────────────────────
# Domain for the dashboard (must match NEXTAUTH_URL)
CADDY_DASHBOARD_DOMAIN=dashboard.myrestaurant.com
# Domain for Frappe (optional)
CADDY_FRAPPE_DOMAIN=erp.myrestaurant.com
# Email for Let's Encrypt certificates
CADDY_EMAIL=admin@myrestaurant.com
