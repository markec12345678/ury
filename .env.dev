# URY Dashboard — Development Environment Variables
# Copy this file to .env and adjust values for your setup

# ── Database (Docker: postgres container) ──────────────────
DATABASE_URL=postgresql://ury:ury_dev_2024@localhost:5432/ury_dashboard

# ── Redis (Docker: redis container) ────────────────────────
REDIS_URL=redis://localhost:6379

# ── Frappe / ERPNext ──────────────────────────────────────
FRAPPE_URL=http://localhost:8000
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# ── Feature Flags ─────────────────────────────────────────
ENABLE_POS=true
ENABLE_KITCHEN=true
ENABLE_RESERVATIONS=false

# ── Misc ──────────────────────────────────────────────────
NODE_ENV=development
