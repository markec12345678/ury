# ── URY Dashboard Environment Configuration ──────────────
# Copy this file to .env and adjust values for your deployment.

# Frappe Backend URL (optional — can also configure via Settings UI)
# Production example: https://erp.myrestaurant.com
NEXT_PUBLIC_FRAPPE_URL=

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-secret-in-production

# Socket.io Real-time Demo Server (for local development only)
NEXT_PUBLIC_SOCKET_PORT=3003

# Auto-refresh interval in milliseconds (default: 30000 = 30s)
NEXT_PUBLIC_REFRESH_INTERVAL=30000

# Default restaurant name shown in demo mode
NEXT_PUBLIC_RESTAURANT_NAME=URY Restaurant

# Currency symbol (€ for EUR, ₹ for INR, etc.)
NEXT_PUBLIC_CURRENCY=€
